#!/bin/bash
# Submit with your own group and queue or reservation (command-line -v replaces the directive below):
#   qsub -P GROUP -q QUEUE -v RTYPE=rt_HF,MILES_REPO=...,MILES_IMAGE=... THIS_FILE
#PBS -l select=2
#PBS -l walltime=64:00:00
#PBS -v RTYPE=rt_HF
#PBS -j oe
set -euo pipefail
: "${MILES_REPO:?}" "${MILES_IMAGE:?}" "${MILES_SCRATCH:?}"
: "${MILES_MODEL_DIR:?}" "${MILES_DATA_DIR:?}" "${MILES_JUDGE_CONFIG:?}"
mkdir -p "${MILES_SCRATCH}/logs"
exec > "${MILES_SCRATCH}/logs/${PBS_JOBID}.log" 2>&1
extra_args=()
if [[ "${MILES_EVAL_BEFORE_TRAIN:-0}" == "1" ]]; then
  extra_args+=(--eval-before-train)
fi
if [[ "${MILES_OPTIMIZER_CPU_OFFLOAD:-1}" == "0" ]]; then
  extra_args+=(--no-optimizer-cpu-offload)
fi
exec python3 "${MILES_REPO}/tools/abci/launch.py" --mode train \
  --repo "${MILES_REPO}" --image "${MILES_IMAGE}" --scratch "${MILES_SCRATCH}" \
  --container-root "${MILES_CONTAINER_ROOT:-}" \
  --model-dir "${MILES_MODEL_DIR}" --data-dir "${MILES_DATA_DIR}" \
  --model-name "${MILES_MODEL_NAME:-Qwen3.5-9B}" \
  --judge-config "${MILES_JUDGE_CONFIG}" --private-pythonpath "${MILES_PRIVATE_PYTHONPATH:-}" \
  --credentials-file "${MILES_CREDENTIALS_FILE:-}" --load "${MILES_LOAD:-}" \
  --checkpoint-dir "${MILES_CHECKPOINT_DIR:-}" --save-interval "${MILES_SAVE_INTERVAL:-5}" \
  --actor-nodes "${MILES_ACTOR_NODES:-1}" --rollout-nodes "${MILES_ROLLOUT_NODES:-1}" \
  --train-tp "${MILES_TRAIN_TP:-4}" --train-cp "${MILES_TRAIN_CP:-1}" --train-ep "${MILES_TRAIN_EP:-1}" \
  --rollout-tp "${MILES_ROLLOUT_TP:-1}" --num-rollout "${MILES_NUM_ROLLOUT:-100}" \
  --ray-object-store-gb "${MILES_RAY_OBJECT_STORE_GB:-16}" \
  --verify-resume-after-updates "${MILES_VERIFY_RESUME_AFTER_UPDATES:-0}" \
  --wandb-project "${MILES_WANDB_PROJECT:-}" --wandb-entity "${MILES_WANDB_ENTITY:-}" "${extra_args[@]}"
